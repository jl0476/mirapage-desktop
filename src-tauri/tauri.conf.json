{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiraPage",
  "version": "0.1.0",
  "identifier": "top.racyan.mirapage-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MiraPage",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Entertainment",
    "shortDescription": "Cross-platform desktop comic reader",
    "longDescription": "MiraPage Desktop is an open-source comic book reader for macOS, Windows, and Linux, designed for efficient browsing of CBZ/CBR/ZIP/RAR/7z archives with a clean Tauri 2 + Vue 3 + OpenSeadragon UI.",
    "publisher": "MiraPage Team",
    "homepage": "https://github.com/top/racyan/mirapage-desktop",
    "createUpdaterArtifacts": false
  },
  "plugins": {}
}